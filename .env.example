# Backend
PORT=8080
CORS_ALLOWED_ORIGINS=http://localhost:5173
IP_ALLOWLIST=
DB_DRIVER=memory
DATABASE_URL=
APP_ENV=development
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=5

# Frontend build-time setting. Keep /api/v1 when the frontend and API share a host.
VITE_API_BASE_URL=/api/v1
FRONTEND_PORT=5173
API_PORT=8082
